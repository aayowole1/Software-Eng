# Template only. Keep the real file outside version control and image context.
# Use: docker compose --env-file /private/orgflow.env -f compose.production.yml ...
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=orgflow.example.edu
DJANGO_CSRF_TRUSTED_ORIGINS=https://orgflow.example.edu
# Enable only after the sole TLS proxy strips/overwrites X-Forwarded-Proto.
DJANGO_TRUST_PROXY_HEADERS=false
DJANGO_HSTS_SECONDS=3600
DJANGO_HSTS_INCLUDE_SUBDOMAINS=false
DJANGO_HSTS_PRELOAD=false

MONGODB_URI=mongodb://mongo:27017
MONGODB_NAME=orgflow
TIME_ZONE=America/Chicago
ORGFLOW_WEB_PORT=8000

# The included MongoDB is private to this Compose network and not published.
# An externally hosted database needs operator-managed authentication/TLS and
# firewall policy in its connection URI. Never expose this private Mongo port.

# smtp is required by default; disabled explicitly disables reset delivery.
DJANGO_EMAIL_POLICY=smtp
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
# Disposable internal SMTP-capture tests only; keep false for real delivery.
DJANGO_ALLOW_INSECURE_SMTP=false

GOOGLE_CLIENT_ID=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
DEEPGRAM_API_KEY=
