FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHON_DOTENV_DISABLED=1 \
    DJANGO_SETTINGS_MODULE=orgflow_project.settings_production

WORKDIR /app
COPY requirements.txt requirements-production.txt ./
RUN pip install --no-cache-dir -r requirements-production.txt \
    && groupadd --gid 10001 orgflow \
    && useradd --uid 10001 --gid orgflow --no-create-home --shell /usr/sbin/nologin orgflow \
    && mkdir -p /var/lib/orgflow/static \
    && chown orgflow:orgflow /var/lib/orgflow/static

# Source stays root-owned and is never replaced by a production host bind mount.
COPY --chown=root:root manage.py ./
COPY --chown=root:root orgflow_project ./orgflow_project
COPY --chown=root:root accounts ./accounts
COPY --chown=root:root membership ./membership
COPY --chown=root:root committees ./committees
COPY --chown=root:root meetings ./meetings
COPY --chown=root:root tasks ./tasks
COPY --chown=root:root core ./core
COPY --chown=root:root mongo_migrations ./mongo_migrations
COPY --chown=root:root deploy ./deploy

USER 10001:10001
EXPOSE 8000
HEALTHCHECK --interval=15s --timeout=8s --start-period=30s --retries=3 \
    CMD ["python", "-c", "import json,os,urllib.request; host=os.environ['DJANGO_ALLOWED_HOSTS'].split(',')[0].strip(); request=urllib.request.Request('http://127.0.0.1:8000/health/ready/',headers={'Host':host}); response=urllib.request.urlopen(request,timeout=6); assert response.status==200 and json.load(response)=={'status':'ready'}"]

# Recordings are process-local. Do not scale workers, threads or web replicas
# until recording state is externalized. Access URLs can contain reset tokens.
CMD ["gunicorn", "orgflow_project.wsgi:application", "--bind", "0.0.0.0:8000", "--workers", "1", "--worker-class", "sync", "--threads", "1", "--timeout", "120", "--max-requests", "0", "--forwarded-allow-ips", "", "--access-logfile", "/dev/null", "--error-logfile", "-"]
