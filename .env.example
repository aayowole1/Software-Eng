# Optional local settings. Copy to .env; do not commit real credentials.
# For Docker, use mongodb://mongo:27017 (Compose sets this automatically).
MONGODB_URI=mongodb://localhost:27017
MONGODB_NAME=orgflow
TIME_ZONE=America/Chicago

# Organization public profile shown on the sign-out dashboard (SCRUM-98).
# ORG_BENEFITS is pipe-separated, e.g. "Networking|Leadership skills|Community"
ORG_NAME=
ORG_MISSION=
ORG_BENEFITS=
ORG_CONTACT_EMAIL=

# Deepgram real-time transcription. Keep this secret; it is used only by the
# Django server and is never sent to the browser.
DEEPGRAM_API_KEY=

# OpenRouter meeting summarization. Keep this secret and set it only on the server.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
# Optional attribution headers sent to OpenRouter.
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=OrgFlow

# Comment moderation defaults to local checks. Set to openrouter only after
# deliberately accepting that comment text will be sent to the configured provider.
COMMENT_MODERATION_PROVIDER=local
COMMENT_MODERATION_MODEL=openai/gpt-4o-mini

# Public client ID from a Google Cloud Web application OAuth client.
# Leave empty to disable Google sign-in. No Google client secret is needed.
GOOGLE_CLIENT_ID=

# Password-reset emails. Leave unset to print emails to the console/logs.
# To send real email (e.g. a Gmail app password), uncomment and fill in:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=true
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=OrgFlow <you@example.com>
